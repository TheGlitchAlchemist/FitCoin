{
  "expo": {
    "name": "FitCoin",
    "slug": "fitcoin-app",
    "version": "1.0.0",
    "orientation": "portrait",
    "userInterfaceStyle": "dark",
    "ios": {
      "supportsTablet": true,
      "infoPlist": {
        "NSMotionUsageDescription": "FitCoin usa el sensor de movimiento para contar tus pasos y calcular tus FitCoins ganados."
      }
    },
    "android": {
      "package": "com.fitcoin.app",
      "softwareKeyboardLayoutMode": "pan",
      "permissions": [
        "android.permission.ACTIVITY_RECOGNITION"
      ]
    },
    "plugins": [
      [
        "expo-sensors",
        {
          "motionPermission": "FitCoin necesita acceso al sensor de movimiento para contar tus pasos y calcular los FitCoins que ganas."
        }
      ]
    ],
    "extra": {
      "eas": {
        "projectId": "17eaefb5-a98d-4ca9-9740-d7b05a73a60a"
      }
    }
  }
}
